# Storage
DATA_DIR=./data
VECTORSTORE_PATH=./data/vectorstore
MAX_UPLOAD_MB=8

# Requirement extraction
MAX_REQUIREMENTS=8
MATCH_THRESHOLD=0.28

# Retrieval: lexical | hybrid | dense
RETRIEVAL_MODE=hybrid
# "lsa" needs only scikit-learn and downloads nothing.
# Set to BAAI/bge-small-en-v1.5 after installing requirements-ml.txt.
EMBEDDING_MODEL=lsa
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60
DENSE_CANDIDATES=50

# Generation (rule-based synthesis; no key, no network, no cost)
CHAT_MODEL=local-rule-based
OPENAI_API_KEY=

# Preprocessing
REDACT_PII_ON_INGEST=true
USE_SPACY=true
PREWARM_MODELS=true

# Agentic path
AGENTIC_ENABLED=true
AGENTIC_INTERRUPT_BEFORE_ATS=true

# Ops
APP_ENV=local
LOG_JSON=false
METRICS_WINDOW_SIZE=1000
EVALUATION_CACHE_SIZE=256
SEARCH_CACHE_SIZE=512
